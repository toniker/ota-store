#!/usr/bin/env python3
"""The `ota-store` command. Symlink it into ~/.local/bin or /usr/local/bin to run it from anywhere."""

import os
import sys

# The first python3 on PATH may be an old one (pyenv, an old Homebrew); the one
# that ships with Xcode is always new enough.
if sys.version_info < (3, 9) and os.path.exists("/usr/bin/python3"):
    os.execv("/usr/bin/python3", ["/usr/bin/python3", os.path.realpath(__file__)] + sys.argv[1:])

# The real path, so a symlink elsewhere still finds the ota_store package next to this file.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from ota_store.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
